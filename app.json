{
  "expo": {
    "name": "Noor Salat",
    "slug": "noor-salat",
    "scheme": "noorsalat",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/9841a7c9-9449-4265-854c-45d0eb0e9294",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#000000",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.noorsalat.app",
      "appleTeamId": "XS2D9CT49Q",
      "config": {
        "usesNonExemptEncryption": false
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      },
      "infoPlist": {
        "UIBackgroundModes": [
          "audio"
        ],
        "NSAlarmKitUsageDescription": "Noor Salat programme le réveil du Fajr pour qu'il sonne même en mode silencieux.",
        "NSFamilyControlsUsageDescription": "Noor Salat met en pause les applis que tu choisis à l'heure de la prière, jusqu'au scan de ton tapis."
      }
    },
    "android": {
      "package": "com.noorsalat.app",
      "adaptiveIcon": {
        "backgroundColor": "#000000",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "VIBRATE",
        "POST_NOTIFICATIONS",
        "FLASHLIGHT",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "NOOR SALAT utilise la caméra pour lire le QR de ton tapis et prendre une photo de preuve.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "NOOR SALAT utilise ta position pour calculer les heures de prière et la Qibla."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF8A5B",
          "sounds": [
            "./assets/sounds/khayr_30.wav",
            "./assets/sounds/adhan_fajr_30.wav",
            "./assets/sounds/adhan_beautiful_30.wav"
          ]
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "NOOR SALAT utilise les capteurs pour la boussole Qibla et le compteur de squats."
        }
      ],
      "expo-audio",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "expo-asset",
      [
        "react-native-device-activity",
        {
          "appGroup": "group.com.noorsalat.app",
          "copyToTargetFolder": false
        }
      ]
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "bundleIdentifier": "com.noorsalat.app.ShieldConfiguration",
                  "targetName": "ShieldConfiguration",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.noorsalat.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.noorsalat.app.ShieldAction",
                  "targetName": "ShieldAction",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.noorsalat.app"
                    ]
                  }
                },
                {
                  "bundleIdentifier": "com.noorsalat.app.ActivityMonitorExtension",
                  "targetName": "ActivityMonitorExtension",
                  "entitlements": {
                    "com.apple.developer.family-controls": true,
                    "com.apple.security.application-groups": [
                      "group.com.noorsalat.app"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "9841a7c9-9449-4265-854c-45d0eb0e9294"
      }
    },
    "owner": "al_amine"
  }
}
