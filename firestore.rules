rules_version = '2';

// Règles Noor Salat : chacun ne voit et ne modifie que ses propres données.
// Le classement ne contient que pseudo, % Noor et série. L'admin lit tout, en lecture seule.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return signedIn()
        && request.auth.token.email in ['bahmouhamedalamine@gmail.com']
        && request.auth.token.email_verified == true;
    }
    function validPseudo(p) { return p == null || (p is string && p.size() <= 24); }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['pseudo', 'qrId', 'city', 'noor', 'streak', 'bestStreak', 'totalPrieres',
                                                  'email', 'anonymous', 'platform', 'updatedAt', 'lastSeen'])
        && validPseudo(request.resource.data.get('pseudo', null));
      allow delete: if isOwner(uid);

      match /jours/{day} {
        allow read: if isOwner(uid) || isAdmin();
        allow create, update: if isOwner(uid)
          && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
          && request.resource.data.keys().hasOnly(['prayers', 'count', 'updatedAt'])
          && request.resource.data.prayers is list
          && request.resource.data.prayers.size() <= 5;
        allow delete: if isOwner(uid);
      }
    }

    match /classement/{uid} {
      allow read: if signedIn();
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['pseudo', 'noor', 'streak', 'updatedAt'])
        && request.resource.data.pseudo is string
        && request.resource.data.pseudo.size() > 0 && request.resource.data.pseudo.size() <= 24
        && request.resource.data.noor is int && request.resource.data.noor >= 0 && request.resource.data.noor <= 100
        && request.resource.data.streak is int && request.resource.data.streak >= 0;
      allow delete: if isOwner(uid) || isAdmin();
    }

    // Tout le reste est fermé.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
